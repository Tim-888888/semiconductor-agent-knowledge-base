# Copy to .env and fill only on the machine or server that runs the project.
APP_ENV=development
DEMO_MODE=true

# External storage services. Use least-privilege accounts that can only access semikb resources.
MONGODB_URI=mongodb://username:password@host:27017/?authSource=admin
MONGODB_DATABASE=semikb
MILVUS_URI=http://host:19530
MILVUS_TOKEN=
MILVUS_INDEX_VERSION=v2
MILVUS_REQUIRE_ACTIVE_ALIAS=true
MINIO_ENDPOINT=host:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
# Standalone Redis deployment settings. Use a dedicated, random password.
REDIS_BIND_ADDRESS=192.168.10.100
REDIS_PASSWORD=
REDIS_URL=redis://:password@host:6379/0

# API providers.
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_KEY=
MINERU_MODEL_VERSION=vlm
MINERU_TIMEOUT_SECONDS=900
MINERU_POLL_SECONDS=3
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Primary/fallback LLM routing. The legacy LLM_* values above remain a Qwen fallback alias.
LLM_PRIMARY_PROVIDER=closeai
LLM_FALLBACK_PROVIDER=qwen
LLM_TIMEOUT_SECONDS=60
CLOSEAI_BASE_URL=https://api.openai-proxy.org/v1
CLOSEAI_API_KEY=
CLOSEAI_MODEL=gpt-5.6-luna
CLOSEAI_REASONING_EFFORT=none
CLOSEAI_VERBOSITY=low
QWEN_API_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen-flash
HYDE_ENABLED=true
HYDE_MAX_OUTPUT_TOKENS=256
RETRIEVAL_RECALL_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_MIN_EVIDENCE=1
RETRIEVAL_MAX_EVIDENCE=8
RETRIEVAL_SCORE_CLIFF_RATIO=0.45
RETRIEVAL_RERANK_MIN_SCORE=0.35
RERANK_PROVIDER=qianwen
RERANK_API_BASE_URL=https://dashscope.aliyuncs.com
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank
RERANK_TIMEOUT_SECONDS=60
ALIYUN_WEB_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
ALIYUN_WEB_MCP_API_KEY=
ALIYUN_WEB_MCP_TOOL_NAME=web_search
WEB_ALLOWED_DOMAINS=

# Local model paths. Keep empty in demo mode.
BGE_M3_MODEL_PATH=
BGE_RERANKER_MODEL_PATH=
BGE_USE_FP16=false
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
