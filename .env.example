# Copy to .env and fill only on the machine or server that runs the project.
APP_ENV=development
DEMO_MODE=true
JWT_SECRET=replace-with-a-random-secret
# Required for the public test environment before issuing a scoped demo JWT.
DEMO_ACCESS_KEY=replace-with-a-random-access-code
MAX_UPLOAD_MIB=100

# Full-stack single-node deployment paths and service initialization credentials.
SEMIKB_DATA_ROOT=/opt/semiconductor-agent-knowledge-base-data
SEMIKB_BACKUP_ROOT=/opt/semiconductor-agent-knowledge-base-backups
MONGO_ROOT_USERNAME=semikb_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=semikb_app
MONGO_APP_PASSWORD=
MILVUS_ROOT_PASSWORD=
MILVUS_MINIO_ROOT_USER=
MILVUS_MINIO_ROOT_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# External storage services. Use least-privilege accounts that can only access semikb resources.
MONGODB_URI=mongodb://username:password@host:27017/?authSource=admin
MONGODB_DATABASE=semikb
MILVUS_URI=http://host:19530
MILVUS_TOKEN=
MILVUS_INDEX_VERSION=v4
MILVUS_SEARCH_COLLECTION=semikb_chunks_active
MILVUS_REQUIRE_ACTIVE_ALIAS=true
MINIO_ENDPOINT=host:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=/objects
# Standalone Redis deployment settings. Use a dedicated, random password.
REDIS_PASSWORD=
REDIS_URL=redis://:password@host:6379/0

# API providers.
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_KEY=
MINERU_MODEL_VERSION=vlm
MINERU_TIMEOUT_SECONDS=900
MINERU_POLL_SECONDS=3
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Primary/fallback LLM routing. The legacy LLM_* values above remain a Qwen fallback alias.
LLM_PRIMARY_PROVIDER=closeai
LLM_FALLBACK_PROVIDER=qwen
LLM_TIMEOUT_SECONDS=60
CLOSEAI_BASE_URL=https://api.openai-proxy.org/v1
CLOSEAI_API_KEY=
CLOSEAI_MODEL=gpt-5.6-luna
CLOSEAI_REASONING_EFFORT=none
CLOSEAI_VERBOSITY=low
QWEN_API_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen-flash
HYDE_ENABLED=true
HYDE_MAX_OUTPUT_TOKENS=256
RETRIEVAL_RECALL_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_MIN_EVIDENCE=1
RETRIEVAL_MAX_EVIDENCE=8
RETRIEVAL_SCORE_CLIFF_RATIO=0.45
RETRIEVAL_RERANK_MIN_SCORE=0.40
RERANK_PROVIDER=qianwen
RERANK_API_BASE_URL=https://dashscope.aliyuncs.com
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank
RERANK_TIMEOUT_SECONDS=60
ALIYUN_WEB_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
ALIYUN_WEB_MCP_API_KEY=
ALIYUN_WEB_MCP_TOOL_NAME=web_search
WEB_ALLOWED_DOMAINS=
AGENT_MAX_CLARIFICATION_ROUNDS=2
AGENT_ANSWER_MAX_OUTPUT_TOKENS=1400
AGENT_STREAM_HEARTBEAT_SECONDS=10

# Online Qwen native dense and sparse embeddings; no local model is loaded.
EMBEDDING_PROVIDER=qianwen
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_OUTPUT_TYPE=dense&sparse
EMBEDDING_TIMEOUT_SECONDS=60
SPARSE_ENCODER_VERSION=qwen3.7-text-embedding-sparse-v1
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
